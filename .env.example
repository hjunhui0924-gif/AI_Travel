# Primary LLM config
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=

# Optional OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional DashScope-compatible config
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional DeepSeek-compatible config
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional embedding config
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional web search
TAVILY_API_KEY=

# Optional AMap Web Service APIs
AMAP_WEB_API_KEY=

# Optional Flight MCP bridge
FLIGHT_MCP_ENABLED=
FLIGHT_MCP_MODE=
FLIGHT_MCP_COMMAND=
FLIGHT_MCP_TIMEOUT_SECONDS=120
FLIGHT_BRIDGE_MODE=package
FLIGHT_MCP_HTTP_URL=
FLIGHT_CTRIP_PROBE_ENABLED=false
FLIGHT_ALLOW_DEMO_DATA=false

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-travel-agent

# Optional OSS settings
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
