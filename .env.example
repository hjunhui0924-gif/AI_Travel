# Primary LLM config
AI_AGENT_PORT=8001
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

# Optional fact-constrained final answer polish; deterministic renderer remains the fallback
TRAVEL_FINALIZER_ENABLED=false

# Optional OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional DashScope-compatible config
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# Optional DeepSeek-compatible config
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional web search
TAVILY_API_KEY=

# Optional AMap Web Service APIs
AMAP_WEB_API_KEY=
# Optional separate key when Static Map is not enabled on AMAP_WEB_API_KEY
AMAP_STATIC_MAP_KEY=
# Optional AMap Web JS API 2.0 for an interactive browser map. These values
# are intentionally VITE_* because the browser must receive them; restrict
# the Web端 (JS API) key by local/production domain in the AMap console.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=
AMAP_HTTP_TIMEOUT_SECONDS=20
AMAP_MAX_RETRIES=1
AMAP_RETRY_BACKOFF_SECONDS=0.6
AMAP_MIN_REQUEST_INTERVAL_SECONDS=0.25

# Optional 12306 public query tuning
RAIL_HTTP_TIMEOUT_SECONDS=8
RAIL_TOTAL_TIMEOUT_SECONDS=18
RAIL_MAX_RETRIES=1
RAIL_TICKET_CACHE_TTL_SECONDS=20
RAIL_STATION_CACHE_TTL_SECONDS=86400
RAIL_HEALTH_ORIGIN=广州南
RAIL_HEALTH_DESTINATION=深圳北

# Optional live-provider smoke-check inputs
FLIGHT_HEALTH_ORIGIN=北京
FLIGHT_HEALTH_DESTINATION=上海

# Optional official Tuniu domestic-flight provider
FLIGHT_MCP_ENABLED=true
FLIGHT_MCP_MODE=tuniu
TUNIU_CLI_COMMAND=tuniu
TUNIU_AUTH_TYPE=apiKey
TUNIU_AUTH_SOURCE=tuniu-cli
TUNIU_API_KEY=
TUNIU_TIMEOUT_SECONDS=30

# The official service limits all keys together to 5 requests/minute and
# 50 requests/day. Search only is enabled by this project; order tools are not
# called automatically.

# Optional legacy authorized provider (use only when FLIGHT_MCP_MODE=variflight)
VARIFLIGHT_API_KEY=
VARIFLIGHT_API_URL=https://mcp.variflight.com/api/v1/mcp/data
VARIFLIGHT_HTTP_TIMEOUT_SECONDS=20
VARIFLIGHT_MAX_RETRIES=1
VARIFLIGHT_RETRY_BACKOFF_SECONDS=0.5
# Optional JSON aliases for cities/airports not in the built-in city-code map
VARIFLIGHT_CITY_CODE_ALIASES_JSON=

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-travel-agent

# Optional OSS settings
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
